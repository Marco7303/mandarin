# Optional: Mori works on-device without these values. Copy to .env.local.
# Hexclave project: enable email/password and allow localhost + your Vercel domain.
NEXT_PUBLIC_HEXCLAVE_PROJECT_ID=
HEXCLAVE_SECRET_SERVER_KEY=
# Only needed if your project requires a publishable client key.
NEXT_PUBLIC_HEXCLAVE_PUBLISHABLE_CLIENT_KEY=
# Legacy NEXT_PUBLIC_STACK_PROJECT_ID, NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY,
# and STACK_SECRET_SERVER_KEY names are also supported.

# Prisma Postgres standard pooled PostgreSQL connection URL (postgres:// or postgresql://).
# Server-only. Never prefix either database URL or the Stack secret with NEXT_PUBLIC_.
DATABASE_URL=
# Optional direct connection for Prisma CLI migrations; defaults to DATABASE_URL.
DIRECT_DATABASE_URL=

# Optional server-only dictionary; uncompressed CC-CEDICT UTF-8 file, not shipped.
# CEDICT_PATH=/absolute/path/to/cedict_ts.u8
