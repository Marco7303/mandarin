generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserState {
  userId    String   @id @map("user_id")
  state     Json     @db.JsonB
  revision  Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("user_state")
}
